{
  "compilerOptions": {
    "strict": true,
    "outDir": "lib",
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "target": "es2024",
    "module": "esnext",
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "strictNullChecks": false,
  },
  "exclude": ["./lib", "./test/**"]
}
