{
  "name": "intruders-server",
  "version": "0.0.1",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "private": true,
  "scripts": {
    "tsc": "tsc --project .",
    "build": "npm run clean && npm run tsc && npm run test",
    "postbuild": "webpack",
    "clean": "rimraf ./out",
    "test": "jest --coverage"
  },
  "dependencies": {
    "aws-lambda": "^1.0.7",
    "aws-sdk": "^2.1271.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.109",
    "@types/cls-hooked": "^4.2.0",
    "@types/express": "~4.11.1",
    "@types/jest": "^29.2.4",
    "@types/lodash": "^4.14.161",
    "@types/node": "^24.0.0",
    "@types/request-promise": "^4.1.48",
    "@types/uuid": "^3.4.5",
    "jest": "^26.6.3",
    "request-promise": "^4.2.6",
    "ts-jest": "^26.5.2",
    "ts-loader": "^9.4.2",
    "ts-node": "^10.9.1",
    "tslint": "^5.20.0",
    "typescript": "^4.9.4",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/*.spec.ts"
    ],
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ]
  }
}
