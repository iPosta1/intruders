{
  "name": "intruders-server",
  "version": "0.0.1",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "private": true,
  "scripts": {
    "tsc": "tsc --project . --noEmit",
    "build": "npm run clean && npm run tsc && npm run test && npm run bundle",
    "bundle": "esbuild src/lambdas/gameLambda.ts src/lambdas/cleanupLambda.ts --bundle --platform=node --target=node24 --outdir=out --sourcemap",
    "clean": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1094.0",
    "@aws-sdk/lib-dynamodb": "^3.1094.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
